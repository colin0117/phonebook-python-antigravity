# ============================================================
# Git Ignore for Phone Book Application
# ============================================================

# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.*.local
*.env

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Python Bytecode, Caches & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test Reports & Playwright Artifacts
reports/*.html
reports/*.png
reports/*.json
test-results/
playwright-report/
blob-report/
playwright/.cache/

# IDE & Text Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Application Logs
*.log
