{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "pages/**/*",
    "fixtures/**/*",
    "support/**/*",
    "utils/**/*",
    "step-definitions/**/*",
    "tests/**/*",
    "playwright.config.ts"
  ]
}
